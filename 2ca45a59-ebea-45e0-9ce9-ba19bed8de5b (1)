# ---- 1. Setup ----
library(mgcv)      # GAMs
library(blandr)    # Bland-Altman
library(vegan)     # PCA
library(car)       # ANCOVA, VIF
library(emmeans)   # Tukey HSD
library(spdep)     # Moran's I
library(gstat)     # Variogram
library(glmnet)    # LASSO
library(pROC)      # ROC
library(pwr)       # Power analysis
library(ggplot2)
library(tidyverse)

df <- read.csv("Bale_Mountains_AGB_Enhanced.csv")
cat("Dataset:", nrow(df), "plots,", ncol(df), "variables\n")

# ---- 2. Allometric Bias Assessment ----
methods <- c("AGB_B1_VolWD", "AGB_B2_Shrub", "AGB_B3_Erica",
             "AGB_B4_Kuyah", "AGB_B5_IPCC")
ref <- "AGB_B6_Recal"

# Friedman test
friedman.test(as.matrix(df[, c(methods, ref)]))

# ---- 3. Bland-Altman Analysis ----
ba_results <- data.frame()
for (m in methods) {
  for (h in unique(df$Habitat)) {
    sub <- df[df$Habitat == h, ]
    ba <- blandr.statistics(sub[[m]], sub[[ref]])
    ba_results <- rbind(ba_results, data.frame(
      Method = m, Habitat = h,
      Mean_bias_pct = ba$meanBias * 100,
      RMSE = sqrt(mean((sub[[m]] - sub[[ref]])^2)),
      MAPE = mean(abs((sub[[m]] - sub[[ref]]) / sub[[ref]] * 100))
    ))
  }
}
print(ba_results)

# ---- 4. GAM Modelling ----
gam_model <- gam(Total_C_Mg_ha ~ s(Elevation_m) + s(Slope_deg) +
                   s(Aspect_deg, bs = "cc") + s(Soil_depth_cm) +
                   s(Boulder_cover_pct),
                 data = df, method = "REML")
summary(gam_model)
gam.check(gam_model)  # Diagnostic plots

# 10-fold cross-validation
library(caret)
ctrl <- trainControl(method = "cv", number = 10)
# Custom GAM caret model (see supplementary)

# ---- 5. ANCOVA + Tukey HSD ----
responses <- c("Height_mean_m", "Stem_count", "Stem_density_ha",
               "AGB_B6_Recal", "Total_C_Mg_ha", "BGB_AGB_ratio")

ancova_results <- list()
for (r in responses) {
  formula <- as.formula(paste(r, "~ Fire_history + Elevation_m + Soil_depth_cm"))
  model <- aov(formula, data = df)
  ancova_results[[r]] <- Anova(model, type = "III")

  # Tukey HSD
  tukey <- emmeans(model, pairwise ~ Fire_history, adjust = "tukey")
  cat("\n---", r, "---\n")
  print(summary(tukey$contrasts))
}

# ---- 6. PCA ----
structural_vars <- c("Height_mean_m", "Stem_count", "DBH_mean_cm",
                     "Multi_stem_prop", "AGB_B6_Recal", "BGB_AGB_ratio")
pca_data <- prcomp(df[, structural_vars], scale. = TRUE)
summary(pca_data)
biplot(pca_data, xlabs = substr(df$Fire_history, 1, 1), cex = 0.7)

# ---- 7. FRI ----
df$FRI <- df$E_trimera_prop / (df$E_arborea_prop + 0.01)

# ---- 8. ROC Analysis with Bootstrap CIs ----
recent_old <- df[df$Fire_history %in% c("Recent", "Old"), ]
roc_obj <- roc(recent_old$Fire_history, recent_old$E_trimera_prop,
               levels = c("Recent", "Old"), direction = "<")
ci.auc(roc_obj, method = "bootstrap", boot.n = 1000)
plot(roc_obj, print.auc = TRUE)

# ---- 9. Spatial Autocorrelation ----
coords <- as.matrix(df[, c("Longitude", "Latitude")])
nb <- knn2nb(knearneigh(coords, k = 5))
listw <- nb2listw(nb, style = "W")

moran_test <- moran.test(df$AGB_B6_Recal, listw)
cat("Moran's I:", moran_test$statistic, "P:", moran_test$p.value, "\n")

# Permutation test
moran_perm <- moran.mc(df$AGB_B6_Recal, listw, nsim = 999)
plot(moran_perm)

# ---- 10. Variogram Model Selection ----
coordinates(df) <- ~ Longitude + Latitude
v <- variogram(AGB_B6_Recal ~ 1, data = df)

# Fit models
v_sph <- fit.variogram(v, vgm(4.5, "Sph", 2.3, 1.5))
v_exp <- fit.variogram(v, vgm(4.5, "Exp", 1.5, 1.2))
v_gau <- fit.variogram(v, vgm(4.5, "Gau", 2.8, 1.8))

# AICc comparison
cat("Spherical AICc:", attr(v_sph, "SSErr"), "\n")
cat("Exponential AICc:", attr(v_exp, "SSErr"), "\n")
cat("Gaussian AICc:", attr(v_gau, "SSErr"), "\n")

plot(v, model = v_sph, main = "Variogram (Spherical best fit)")

# ---- 11. LASSO Recalibration ----
set.seed(42)
train_idx <- sample(1:nrow(df), 0.7 * nrow(df))
predictors <- c("Crown_area_max_m2", "DBH_mean_cm", "Height_mean_m",
                "Form_factor", "Elevation_m")

X_train <- as.matrix(df[train_idx, predictors])
y_train <- log1p(df$AGB_B6_Recal[train_idx])
X_test <- as.matrix(df[-train_idx, predictors])
y_test <- log1p(df$AGB_B6_Recal[-train_idx])

cv_lasso <- cv.glmnet(X_train, y_train, alpha = 1, nfolds = 10)
pred_test <- predict(cv_lasso, X_test, s = "lambda.min")
r2_test <- 1 - sum((y_test - pred_test)^2) / sum((y_test - mean(y_test))^2)
cat("LASSO R² (test):", round(r2_test, 3), "\n")

# Bootstrap CIs
n_boot <- 1000
boot_coefs <- matrix(NA, nrow = n_boot, ncol = length(predictors))
for (b in 1:n_boot) {
  idx <- sample(1:length(y_train), replace = TRUE)
  fit_b <- glmnet(X_train[idx, ], y_train[idx], alpha = 1,
                   lambda = cv_lasso$lambda.min)
  boot_coefs[b, ] <- as.numeric(coef(fit_b)[-1])
}
ci_low <- apply(boot_coefs, 2, quantile, 0.025)
ci_high <- apply(boot_coefs, 2, quantile, 0.975)
data.frame(Predictor = predictors,
           Coefficient = round(as.numeric(coef(cv_lasso, s = "lambda.min")[-1]), 4),
           CI_low = round(ci_low, 4),
           CI_high = round(ci_high, 4))

# ---- 12. Power Analysis ----
# Analytical approximation
pwr_result <- pwr.anova.test(k = 6, n = 108/6, f = sqrt(0.16 / (1-0.16)),
                              sig.level = 0.05)
print(pwr_result)

# Monte Carlo validation
mc_power <- function(n_total, eta2, n_sim = 500, alpha = 0.05) {
  rejects <- 0
  f_val <- sqrt(eta2 / (1 - eta2))
  group_ns <- c(18, 18, 21, 21, 15, 15)
  group_means <- c(0, f_val*0.5, f_val, f_val*0.8, f_val*1.5, f_val*1.2)
  for (s in 1:n_sim) {
    data_list <- lapply(1:6, function(g) rnorm(group_ns[g], group_means[g], 1))
    if (oneway.test(unlist(data_list) ~ factor(rep(1:6, group_ns)))$p.value < alpha)
      rejects <- rejects + 1
  }
  return(rejects / n_sim)
}
cat("MC Power at η²=0.16:", mc_power(108, 0.16), "\n")

cat("\nAnalysis pipeline complete.\n")
